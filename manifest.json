{
  "name": "Gacha game checkin",
  "description": "Checkin extention for multiple gacha games by Nyaruko",
  "version": "2.1",
  "icons": {
    "16": "img/icon.png",
    "48": "img/icon.png",
    "128": "img/icon.png"
  },
  "host_permissions": [
    "*://*.hoyolab.com/*",
    "*://*.skport.com/*"
  ],
  "permissions": [
    "storage",
    "webRequest",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "img/icon.png",
    "default_title": "Click To Check In"
  },
  "manifest_version": 3
}